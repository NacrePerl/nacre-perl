[% SET perl_version_under = perl_version.replace('\.','_') -%]
% DO NOT EDIT!
%
% Generated by `perl_v.lgt.tt2`.
%   - perl_version: [% perl_version %]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
:- object(perl_[% perl_version_under %],
	imports(opcode_table)).

	:- info([
		version is 1:0:0,
		comment is 'Opcode table for Perl [% perl_version %].'
	]).

	:- include(nacre_perl_generated_op('perl_[% perl_version_under %].pl')).

:- end_object.
